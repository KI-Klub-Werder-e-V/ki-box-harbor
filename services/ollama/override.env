# This file can be used for additional environment variables
# specifically for the "ollama" service.
# You can also use the "harbor env" command to set these variables.
# KI-Box: sized for 16 GB RAM without GPU. Longer context costs RAM.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_ORIGINS="*"
OLLAMA_HOST="0.0.0.0"
# Disables TLS verification on model pulls. If you are behind a corporate proxy,
# opt in with: harbor env ollama OLLAMA_INSECURE true
# OLLAMA_INSECURE="true"
