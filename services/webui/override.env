# This file can be used for additional environment variables
# specifically for the "webui" service.
# You can also use the "harbor env" command to set these variables.
# KI-Box defaults. Most of these are read on the very first start only;
# afterwards change them in the admin settings.
# Keep the generated secret in the persisted data dir, not in the container.
WEBUI_SECRET_KEY_FILE=/app/backend/data/.webui_secret_key
DEFAULT_LOCALE=de-DE
# German-capable embeddings via Ollama instead of the English default model
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=bge-m3:latest
ENABLE_ADMIN_CHAT_ACCESS=false
DEFAULT_USER_ROLE=pending
